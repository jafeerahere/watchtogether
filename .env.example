# Copy to .env (or set in your host's environment). All values are optional.

# HTTP(S) port for the Node server (serves the built client + Socket.IO).
PORT=3001

# Serve HTTPS directly from Node (e.g. certs from mkcert or Let's Encrypt).
# Leave unset when a reverse proxy (Caddy/nginx) terminates TLS.
# SSL_KEY_FILE=certs/key.pem
# SSL_CERT_FILE=certs/cert.pem

# Set to 1 when running behind a reverse proxy.
# TRUST_PROXY=1

# ICE servers handed to clients when they join a room.
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Either static credentials...
# TURN_USERNAME=watchtogether
# TURN_CREDENTIAL=change-me
# ...or a coturn `static-auth-secret` for short-lived per-user credentials (preferred).
# TURN_SECRET=long-random-string
# TURN_TTL_SECONDS=43200

# Force every connection through TURN (use this to prove your TURN server works).
# ICE_TRANSPORT_POLICY=relay
