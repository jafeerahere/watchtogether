{
  "name": "watchtogether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch-party rooms for up to four people: screen share, synced links, voice, and gesture memes.",
  "scripts": {
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "predev": "node scripts/setup-mediapipe.mjs --quiet",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "prebuild": "node scripts/setup-mediapipe.mjs --quiet",
    "build": "npm run typecheck && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "cross-env": "^7.0.3",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "~5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
